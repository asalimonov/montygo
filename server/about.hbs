<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<title>Third-party licences of monty-server</title>
<style>
body { font-family: sans-serif; margin: 2em; max-width: 60em; }
pre { white-space: pre-wrap; border: 1px solid #ccc; padding: 1em; }
</style>
</head>
<body>
<h1>Third-party licences of monty-server</h1>
<p>Rust crates linked into <code>monty-server</code>, grouped by licence.</p>
<ul>
{{#each overview}}
<li><a href="#{{id}}">{{name}}</a> ({{count}})</li>
{{/each}}
</ul>
{{#each licenses}}
<h2 id="{{id}}">{{name}}</h2>
<ul>
{{#each used_by}}
<li><a href="{{#if crate.repository}}{{crate.repository}}{{else}}https://crates.io/crates/{{crate.name}}{{/if}}">{{crate.name}} {{crate.version}}</a></li>
{{/each}}
</ul>
<pre>{{text}}</pre>
{{/each}}
</body>
</html>
